<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             x:Class="SpellCrafter.App">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!-- Provide MaterialModernScrollBar in the Application resource scope
				     so the auto-included Material.Avalonia.DataGrid ControlTheme can
				     resolve {StaticResource MaterialModernScrollBar} at runtime. -->
				<ResourceInclude Source="avares://Material.Styles/Resources/Themes/ScrollBar.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>
    <Application.Styles>
		<themes:MaterialThemeBase/>
		<StyleInclude Source="avares://SpellCrafter/Controls/MetroWindow.paml"/>
		<StyleInclude Source="avares://SpellCrafter/Controls/MenuButton.axaml"/>
		<StyleInclude Source="avares://SpellCrafter/Styles/DataGrid.axaml"/>
		<StyleInclude Source="avares://SpellCrafter/Styles/ContextMenu.axaml"/>
		<StyleInclude Source="avares://SpellCrafter/Styles/TabControl.axaml"/>
		<StyleInclude Source="avares://SpellCrafter/Assets/Icons.axaml"/>

    </Application.Styles>
</Application>
